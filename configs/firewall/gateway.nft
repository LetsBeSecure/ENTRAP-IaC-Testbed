#!/usr/sbin/nft -f

# Edge firewall for gateway1 (internet boundary). Policy: drop forward,
# only internal-initiated traffic (and its replies) crosses. Nothing
# unsolicited from wan-net reaches link-net/coreswitch/infra/client.

flush ruleset

table inet fw {
    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept

        # internal network (everything behind coreswitch) -> internet
        iifname "enp1s0" oifname "enp2s0" accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "enp2s0" masquerade
    }
}
