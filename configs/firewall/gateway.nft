#!/usr/sbin/nft -f

# Enterprise edge firewall + Suricata IPS for gateway1.
#
# Interfaces:
#   enp2s0 = WAN (wan-net 173.168.0.0/24 — hypervisor virbr1, simulated internet)
#   enp1s0 = LAN (link-net 10.10.0.0/24 → coreswitch → infra/client nets)
#
# Threat model: ransomware enters via compromised/rogue LAN client (phishing,
# drive-by download, insider). C2 beacons outbound LAN→WAN. Suricata detects
# and drops. Only web1:80 exposed to WAN via DNAT; all other inbound blocked.
#
# Firewall logs: journalctl -k --grep "nft-" -f

flush ruleset

define WAN_IF    = "enp2s0"
define LAN_IF    = "enp1s0"
define MGMT_NET  = 173.168.0.0/24
define WEB_SRV   = 10.10.10.10

# NAT in table ip (IPv4-only) — dnat/masquerade require ip family on Ubuntu 22.04 nftables.
table ip nat {

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        # DNAT: HTTP on WAN IP → web1 (enterprise.lab web server).
        # Suricata inspects in FORWARD chain after DNAT rewrites destination.
        iifname $WAN_IF tcp dport 80 dnat ip to $WEB_SRV:80
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname $WAN_IF masquerade
    }
}

# Stateful filter in table inet (IPv4 + IPv6).
table inet fw {

    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept

        ct state invalid log prefix "nft-INPUT-invalid: " drop

        # Return traffic for gateway1-initiated outbound (apt, DNS, NTP)
        ct state { established, related } accept

        # SSH from hypervisor management network (wan-net / virbr1).
        # Ansible connects directly to 173.168.0.10 — no ProxyJump for gateway1 itself.
        iifname $WAN_IF ip saddr $MGMT_NET tcp dport 22 ct state new accept

        # SSH from LAN side (link-net admin access)
        iifname $LAN_IF tcp dport 22 ct state new accept

        # ICMP echo from LAN for diagnostics
        iifname $LAN_IF icmp type echo-request accept

        # All else: log then drop (policy)
        log prefix "nft-INPUT-drop: " drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # Discard malformed/out-of-window packets before queuing
        ct state invalid log prefix "nft-FWD-invalid: " drop

        # WAN→web1:80 (DNAT'd HTTP): send through Suricata for web attack inspection.
        # Must be before the blanket inbound-drop rule.
        iifname $WAN_IF oifname $LAN_IF ip daddr $WEB_SRV tcp dport 80 ct state new queue num 0 bypass

        # Block all other unsolicited WAN→LAN new sessions.
        iifname $WAN_IF oifname $LAN_IF ct state new log prefix "nft-FWD-inbound-drop: " drop

        # All remaining → Suricata NFQUEUE IPS (both directions).
        # Both directions required: HTTP response bodies, TLS, stream_size exfil detection.
        # bypass = fail-open if Suricata down.
        queue num 0 bypass
    }
}
